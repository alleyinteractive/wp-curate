{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wp-curate/channel-loop",
  "version": "0.1.0",
  "title": "Channel Loop",
  "category": "theme",
  "icon": "screenoptions",
  "description": "Displays posts from the surrounding channel using the same template.",
  "textdomain": "wp-curate",
  "ancestor": [
    "wp-curate/channel-content"
  ],
  "editorScript": "file:index.ts",
  "render": "file:render.php",
  "supports": {
    "html": false
  },
  "attributes": {
    "template": {
      "type": "array",
      "default": [
        [
          "core/post-title",
          {
            "isLink": true
          }
        ]
      ]
    }
  },
  "providesContext": {
    "wp-curate/loopTemplate": "template"
  }
}
