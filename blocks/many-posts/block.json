{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wp-curate/many-posts",
  "version": "0.1.0",
  "title": "Many Posts",
  "category": "theme",
  "icon": "screenoptions",
  "description": "Promotes many posts. Each Single Post block inside shows a post from this block's channel, in this block's template.",
  "textdomain": "wp-curate",
  "editorScript": "file:index.ts",
  "render": "file:render.php",
  "supports": {
    "html": false,
    "wp-curate/channel": true
  },
  "attributes": {
    "template": {
      "type": "array",
      "default": [
        [
          "core/post-title",
          {
            "isLink": true
          }
        ]
      ]
    }
  },
  "providesContext": {
    "wp-curate/channel": "channel",
    "wp-curate/postTemplate": "template"
  }
}
