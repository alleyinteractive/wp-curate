{
  "name": "wp-curate",
  "version": "1.0.0",
  "license": "GPL-2.0-or-later",
  "main": "wp-curate.php",
  "engines": {
    "node": "20",
    "npm": "10"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "scripts": {
    "build": "alley-build build",
    "create-block": "npx @alleyinteractive/create-block@latest -n wp-curate",
    "precheck-types": "check-node-version --package",
    "check-types": "tsc",
    "lint:fix": "eslint --ext .jsx --ext .js --ext .ts --ext .tsx . --fix",
    "lint": "npm run check-types && eslint --ext .jsx --ext .js --ext .ts --ext .tsx .",
    "packages-update": "alley-build packages-update --dist-tag=wp-6.4",
    "postinstall": "rm -rf node_modules/.cache/babel-loader && rm -rf node_modules/.cache/webpack",
    "prebuild": "check-node-version --package",
    "predev": "check-node-version --package",
    "preinstall": "check-node-version --package",
    "prelint:fix": "check-node-version --package",
    "prelint": "check-node-version --package",
    "prestylelint:fix": "check-node-version --package",
    "prestylelint": "check-node-version --package",
    "pretest:watch": "check-node-version --package",
    "pretest": "check-node-version --package",
    "start": "alley-build start",
    "start:hot": "alley-build start --hot",
    "stylelint:fix": "stylelint --fix \"**/*.scss\"",
    "stylelint": "stylelint \"**/*.scss\" --allow-empty-input",
    "test:watch": "jest --watch",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@alleyinteractive/block-editor-tools": "^0.14.0",
    "@types/jest": "^30.0.0",
    "@types/wordpress__block-editor": "^11.5.0",
    "@uidotdev/usehooks": "^2.4.1",
    "@wordpress/api-fetch": "^7.31.0",
    "@wordpress/block-editor": "^15.4.0",
    "@wordpress/blocks": "^15.4.0",
    "@wordpress/components": "^30.4.0",
    "@wordpress/compose": "^7.31.0",
    "@wordpress/core-data": "^7.31.0",
    "@wordpress/data": "^10.31.0",
    "@wordpress/edit-post": "^8.31.0",
    "@wordpress/element": "^6.31.0",
    "@wordpress/i18n": "^6.4.0",
    "@wordpress/icons": "^10.31.0",
    "@wordpress/plugins": "^7.31.0",
    "@wordpress/url": "^4.31.0",
    "ajv": "^8.17.1",
    "classnames": "^2.5.1",
    "dompurify": "^3.3.0",
    "prop-types": "^15.8.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "swr": "^2.3.6",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@alleyinteractive/build-tool": "^0.3.0",
    "@alleyinteractive/eslint-config": "^0.2.0",
    "@alleyinteractive/stylelint-config": "^0.1.0",
    "@babel/preset-env": "^7.28.5",
    "@types/uuid": "^11.0.0",
    "@types/wordpress__edit-post": "^7.5.1",
    "@types/wordpress__plugins": "^3.0.0",
    "@wordpress/babel-preset-default": "^8.31.0",
    "babel-jest": "^30.2.0",
    "check-node-version": "^4.2.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3",
    "webpack-cli": "^6.0.1",
    "wp-types": "^4.68.1"
  }
}
